# Supabase (클라이언트 노출용 — NEXT_PUBLIC_ 접두사)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 키 (절대 NEXT_PUBLIC_ 접두사 붙이지 말 것)
# SUPABASE_SERVICE_ROLE_KEY=

# Pixabay 이미지 검색 (서버 전용 키 — NEXT_PUBLIC_ 접두사 금지)
PIXABAY_API_KEY=

# 결제 킬스위치 (서버 전용) — 'true'일 때만 구독 발급·정기결제가 동작한다.
# 미설정 = 판매 중지 (기본값). 유료 기능이 0개인 동안은 켜지 않는다.
# 해제 전 선결: ① 유료 기능 1개 라이브 ② 가격 확정(39,000원은 구 초안) ③ @imgly 상용 라이선스 정리
# BILLING_ENABLED=true
